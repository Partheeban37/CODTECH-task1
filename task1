import tkinter as tk
from tkinter import ttk

# Function to check password strength
def check_password_strength():
    password = password_entry.get()
    strength_label.config(text='', foreground='black')  # Reset label
    strength = 0

    # Check password criteria
    if len(password) >= 8:
        strength += 1
    if any(c.islower() for c in password):
        strength += 1
    if any(c.isupper() for c in password):
        strength += 1
    if any(c.isdigit() for c in password):
        strength += 1
    if any(c in '!@#$%^&*()-_=+[{]}|;:\'",<.>/?' for c in password):
        strength += 1

    # Display the strength feedback
    if strength == 0:
        strength_label.config(text='Password Strength: Weak', foreground='red')
    elif strength == 1 or strength == 2:
        strength_label.config(text='Password Strength: Medium', foreground='orange')
    elif strength >= 3:
        strength_label.config(text='Password Strength: Strong', foreground='green')

# Set up the main window
root = tk.Tk()
root.title("Password Strength Checker")
root.geometry("400x200")

# Create a label
label = tk.Label(root, text="Enter Password:", font=("Arial", 14))
label.pack(pady=10)

# Create an entry widget for password input
password_entry = tk.Entry(root, show="*", font=("Arial", 14))
password_entry.pack(pady=10)

# Create a button to check password strength
check_button = ttk.Button(root, text="Check Strength", command=check_password_strength)
check_button.pack(pady=10)

# Create a label to display password strength
strength_label = tk.Label(root, text="Password Strength: ", font=("Arial", 14))
strength_label.pack(pady=10)

# Start the GUI
root.mainloop()
